<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:dcterms="http://purl.org/dc/terms/">
  <owl:Ontology rdf:about="https://pletka.io/ontologies/defaults/">
    <rdfs:label xml:lang="en">W3C Defaults</rdfs:label>
    <rdfs:comment xml:lang="en">Curated subset of the standard W3C and Dublin Core vocabularies referenced by Pletka fields and ontologies (rdf, rdfs, owl, xsd, skos, dc, dcterms). Terms are declared under their canonical namespaces; this ontology exists so standard terms are first-class rows instead of audit exceptions.</rdfs:comment>
    <owl:versionInfo>1.0</owl:versionInfo>
  </owl:Ontology>

  <!-- Classes -->
  <rdfs:Class rdf:about="http://www.w3.org/2000/01/rdf-schema#Resource">
    <rdfs:label xml:lang="en">Resource</rdfs:label>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/2000/01/rdf-schema#Literal">
    <rdfs:label xml:lang="en">Literal</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
    <rdfs:label xml:lang="en">Concept</rdfs:label>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme">
    <rdfs:label xml:lang="en">Concept Scheme</rdfs:label>
  </rdfs:Class>

  <!-- Datatypes (parsed as classes via Task 1) -->
  <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#string">
    <rdfs:label xml:lang="en">string</rdfs:label>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#integer">
    <rdfs:label xml:lang="en">integer</rdfs:label>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#decimal">
    <rdfs:label xml:lang="en">decimal</rdfs:label>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#boolean">
    <rdfs:label xml:lang="en">boolean</rdfs:label>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date">
    <rdfs:label xml:lang="en">date</rdfs:label>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#dateTime">
    <rdfs:label xml:lang="en">dateTime</rdfs:label>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear">
    <rdfs:label xml:lang="en">gYear</rdfs:label>
  </rdfs:Datatype>
  <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#anyURI">
    <rdfs:label xml:lang="en">anyURI</rdfs:label>
  </rdfs:Datatype>

  <!-- Properties -->
  <rdf:Property rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#type">
    <rdfs:label xml:lang="en">type</rdfs:label>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#value">
    <rdfs:label xml:lang="en">value</rdfs:label>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/2000/01/rdf-schema#label">
    <rdfs:label xml:lang="en">label</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/2002/07/owl#sameAs">
    <rdfs:label xml:lang="en">same as</rdfs:label>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch">
    <rdfs:label xml:lang="en">exact match</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/2004/02/skos/core#topConceptOf">
    <rdfs:label xml:lang="en">top concept of</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://purl.org/dc/elements/1.1/format">
    <rdfs:label xml:lang="en">format</rdfs:label>
  </rdf:Property>
  <rdf:Property rdf:about="http://purl.org/dc/terms/conformsTo">
    <rdfs:label xml:lang="en">conforms to</rdfs:label>
  </rdf:Property>
</rdf:RDF>
