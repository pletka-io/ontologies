<?xml version="1.0" encoding="UTF-8"?>
<!--
  DaSCH Standard Models - Flat edition (dasch-sm-flat), RDFS v3, in the style of the CIDOC CRM RDFS file.
  Revised 2026-10-26. EXTENSION of knora-base: load knora-base-rdfs_v60.rdfs first (base ontology),
  then this file. This file declares only the new terms; knora-base terms are referenced by full IRI.
  Companion files: dasch-sm-flat_mappings.xlsx; specification "DaSCH Standard Models - Flat - Specification v3".

  Namespaces
    New terms (dsm:)        http://www.knora.org/ontology/standard-models#   written "#Name"
    knora-base terms (kb:)  http://www.knora.org/ontology/knora-base#        referenced by full IRI, declared in knora-base-rdfs_v60.rdfs

  Model properties point to knora-base value classes, not literals, e.g.
     Image  -hasCreationDate->  DateValue  -valueHasStartJDN->  xsd:integer
  Every property that points to a value is a subproperty of kb:hasValue.
  External mappings (dcterms, schema.org, CIDOC CRM, ...) are not in this file;
  see dasch-sm-flat_mappings.xlsx.
-->
<rdf:RDF xml:lang="en"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:knora-base="http://www.knora.org/ontology/knora-base#"
    xmlns:dsm="http://www.knora.org/ontology/standard-models#"
    xml:base="http://www.knora.org/ontology/standard-models">


  <!-- ========== CLASSES: Entity and its subclasses (new terms, standard-models namespace) ========== -->

  <rdfs:Class rdf:about="#Entity">
    <rdfs:label xml:lang="en">Entity</rdfs:label>
    <rdfs:label xml:lang="de">Entität</rdfs:label>
    <rdfs:comment xml:lang="en">Top-level class for all resources described by the standard data models. Every instance must have exactly one rdfs:label and a description (hasDescription).</rdfs:comment>
    <rdfs:comment xml:lang="de">Oberklasse aller in den Standarddatenmodellen beschriebenen Ressourcen.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.knora.org/ontology/knora-base#Resource"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#InformationResource">
    <rdfs:label xml:lang="en">Information Resource</rdfs:label>
    <rdfs:label xml:lang="de">Informationsressource</rdfs:label>
    <rdfs:comment xml:lang="en">Resources carrying information content, with or without an attached file.</rdfs:comment>
    <rdfs:comment xml:lang="de">Ressourcen mit Informationsinhalt, mit oder ohne zugehörige Datei.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="#Entity"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Model_3D">
    <rdfs:label xml:lang="en">Model 3D</rdfs:label>
    <rdfs:comment xml:lang="en">This class may contain 3D-image documents.</rdfs:comment>
    <rdfs:comment xml:lang="de">Diese Klasse kann 3D-Bild-Dokumente enthalten.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.knora.org/ontology/knora-base#DDDRepresentation"/>
    <rdfs:subClassOf rdf:resource="#InformationResource"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Archive">
    <rdfs:label xml:lang="en">Archive</rdfs:label>
    <rdfs:comment xml:lang="en">This class may contain documents of type zip, tar, gz, z, tar.gz, tgz, gzip, or 7z.</rdfs:comment>
    <rdfs:comment xml:lang="de">Diese Klasse kann Dokumente vom Typ zip, tar, gz, z, tar.gz, tgz, gzip, oder 7z enthalten.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.knora.org/ontology/knora-base#ArchiveRepresentation"/>
    <rdfs:subClassOf rdf:resource="#InformationResource"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Document">
    <rdfs:label xml:lang="en">Document</rdfs:label>
    <rdfs:comment xml:lang="en">This class may contain documents of type pdf, doc, docx, xls, xlsx, ppt, pptx, epub</rdfs:comment>
    <rdfs:comment xml:lang="de">Diese Klasse kann Dokumente vom Typ pdf, doc, docx, xls, xlsx, ppt, pptx, epub enthalten.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.knora.org/ontology/knora-base#DocumentRepresentation"/>
    <rdfs:subClassOf rdf:resource="#InformationResource"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Image">
    <rdfs:label xml:lang="en">Image</rdfs:label>
    <rdfs:comment xml:lang="en">This class may contain image documents of type jpg, jpeg, png, tif, tiff, or jp2.</rdfs:comment>
    <rdfs:comment xml:lang="de">Diese Klasse kann Bild-Dokumente vom Typ jpg, jpeg, png, tif, tiff, oder jp2 enthalten.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="#InformationResource"/>
    <rdfs:subClassOf rdf:resource="http://www.knora.org/ontology/knora-base#StillImageRepresentation"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Text">
    <rdfs:label xml:lang="en">Text</rdfs:label>
    <rdfs:comment xml:lang="en">This class may contain documents of type txt, csv, xml, html, xsl, xsd, odd, rng, or json.</rdfs:comment>
    <rdfs:comment xml:lang="de">Diese Klasse kann Textdokumente vom Typ txt, csv, xml, html, xsl, xsd, odd, rng, oder json files enthalten.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="#InformationResource"/>
    <rdfs:subClassOf rdf:resource="http://www.knora.org/ontology/knora-base#TextRepresentation"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#NoRepresentation">
    <rdfs:label xml:lang="en">NoRepresentation</rdfs:label>
    <rdfs:comment xml:lang="en">This class contains objects without files.</rdfs:comment>
    <rdfs:comment xml:lang="de">Diese Klasse enthält Objekte ohne Dateien.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="#InformationResource"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#TimeBasedMedia">
    <rdfs:label xml:lang="en">Time Based Media</rdfs:label>
    <rdfs:label xml:lang="de">Zeitbasierte Medien</rdfs:label>
    <rdfs:comment xml:lang="en">Information resources with a duration, such as audio and video.</rdfs:comment>
    <rdfs:comment xml:lang="de">Informationsressourcen mit einer Dauer, z. B. Audio und Video.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="#InformationResource"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Audio">
    <rdfs:label xml:lang="en">Audio</rdfs:label>
    <rdfs:comment xml:lang="en">This class may contain audio documents of type mp3, or wav.</rdfs:comment>
    <rdfs:comment xml:lang="de">Diese Klasse kann Audio-Dokumente vom Typ mp3, oder wav files enthalten.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.knora.org/ontology/knora-base#AudioRepresentation"/>
    <rdfs:subClassOf rdf:resource="#TimeBasedMedia"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Video">
    <rdfs:label xml:lang="en">Video</rdfs:label>
    <rdfs:comment xml:lang="en">This class may contain video documents of type mp4.</rdfs:comment>
    <rdfs:comment xml:lang="de">Diese Klasse kann Video-Dokumente vom Typ mp4 enthalten.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.knora.org/ontology/knora-base#MovingImageRepresentation"/>
    <rdfs:subClassOf rdf:resource="#TimeBasedMedia"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Agent">
    <rdfs:label xml:lang="en">Agent</rdfs:label>
    <rdfs:label xml:lang="de">Akteur</rdfs:label>
    <rdfs:comment xml:lang="en">Persons and organisations.</rdfs:comment>
    <rdfs:comment xml:lang="de">Personen und Organisationen.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="#Entity"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Person">
    <rdfs:label xml:lang="en">Person</rdfs:label>
    <rdfs:comment xml:lang="en">This class contains properties suitable to describe persons.</rdfs:comment>
    <rdfs:comment xml:lang="de">Diese Klasse enthält Angaben zu Personen.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="#Agent"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Organisation">
    <rdfs:label xml:lang="en">Organisation</rdfs:label>
    <rdfs:comment xml:lang="en">This class contains properties suitable to describe organisations.</rdfs:comment>
    <rdfs:comment xml:lang="de">Diese Klasse enthält Angaben zu Organisationen.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="#Agent"/>
    <rdfs:subClassOf rdf:resource="#GeoReferencedEntity"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#GeoReferencedEntity">
    <rdfs:label xml:lang="en">Geo Referenced Entity</rdfs:label>
    <rdfs:label xml:lang="de">Georeferenzierte Entität</rdfs:label>
    <rdfs:comment xml:lang="en">Entities that can carry coordinates and gazetteer identifiers (latitude, longitude, GeoNames, Getty TGN). Introduced to give these properties, which the flat Organisation and Place models share, a single domain.</rdfs:comment>
    <rdfs:comment xml:lang="de">Entitäten mit Koordinaten und Gazetteer-Identifikatoren.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="#Entity"/>
  </rdfs:Class>

  <rdfs:Class rdf:about="#Place">
    <rdfs:label xml:lang="en">Place</rdfs:label>
    <rdfs:comment xml:lang="en">This class contains properties suitable to describe places.</rdfs:comment>
    <rdfs:comment xml:lang="de">Diese Klasse enthält Angaben zu Orten.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="#GeoReferencedEntity"/>
  </rdfs:Class>


  <!-- ========== PROPERTIES of Entity ========== -->

  <rdf:Property rdf:about="#hasIdentifier">
    <rdfs:label xml:lang="en">ID</rdfs:label>
    <rdfs:label xml:lang="de">ID</rdfs:label>
    <rdfs:comment xml:lang="en">Unique ID of the resource</rdfs:comment>
    <rdfs:comment xml:lang="de">Eindeutige ID der Ressource</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#Entity"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#TextValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasKeywordsList">
    <rdfs:label xml:lang="en">Subject</rdfs:label>
    <rdfs:label xml:lang="de">Thema</rdfs:label>
    <rdfs:comment xml:lang="en">Keywords or concept</rdfs:comment>
    <rdfs:comment xml:lang="de">Schlüsselwörter oder Konzept</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#Entity"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#ListValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasLocationList">
    <rdfs:label xml:lang="en">Places</rdfs:label>
    <rdfs:label xml:lang="de">Orte</rdfs:label>
    <rdfs:comment xml:lang="en">Locations resource bears relation to</rdfs:comment>
    <rdfs:comment xml:lang="de">Orte, zu denen Ressource Bezug hat</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#Entity"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#ListValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasWikidataLink">
    <rdfs:label xml:lang="en">Wikidata identifier</rdfs:label>
    <rdfs:label xml:lang="de">Wikidata Identifikator</rdfs:label>
    <rdfs:comment xml:lang="en">Wikidata identifier resource is identified with</rdfs:comment>
    <rdfs:comment xml:lang="de">Wikidata-Identifikator; mit dem Ressource identifiziert wird</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#Entity"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#UriValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasExternalLink">
    <rdfs:label xml:lang="en">External Link</rdfs:label>
    <rdfs:label xml:lang="de">Externer Link</rdfs:label>
    <rdfs:comment xml:lang="en">External Link resource bears relation to</rdfs:comment>
    <rdfs:comment xml:lang="de">Externer Link; zu denen Ressource Bezug hat</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#Entity"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#UriValue"/>
  </rdf:Property>


  <!-- ========== PROPERTIES of InformationResource ========== -->

  <rdf:Property rdf:about="#hasCreator">
    <rdfs:label xml:lang="en">Creator</rdfs:label>
    <rdfs:label xml:lang="de">Autor</rdfs:label>
    <rdfs:comment xml:lang="en">Main creator/author</rdfs:comment>
    <rdfs:comment xml:lang="de">Haupturheber/Autor</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#InformationResource"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#TextValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasContributor">
    <rdfs:label xml:lang="en">Contributor</rdfs:label>
    <rdfs:label xml:lang="de">Mitwirkende</rdfs:label>
    <rdfs:comment xml:lang="en">Other contributors (e.g. editor)</rdfs:comment>
    <rdfs:comment xml:lang="de">Weitere Mitwirkende (z. B. Herausgeber)</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#InformationResource"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#TextValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasPublisher">
    <rdfs:label xml:lang="en">Publisher</rdfs:label>
    <rdfs:label xml:lang="de">Herausgeber</rdfs:label>
    <rdfs:comment xml:lang="en">Publishing organization/person</rdfs:comment>
    <rdfs:comment xml:lang="de">Veröffentlichende Organisation/Person</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#InformationResource"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#TextValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasCreationDate">
    <rdfs:label xml:lang="en">Creation date</rdfs:label>
    <rdfs:label xml:lang="de">Erstellungsdatum</rdfs:label>
    <rdfs:comment xml:lang="en">Creation date</rdfs:comment>
    <rdfs:comment xml:lang="de">Erstellungsdatum</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#InformationResource"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#DateValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasDate">
    <rdfs:label xml:lang="en">Date</rdfs:label>
    <rdfs:label xml:lang="de">Datum</rdfs:label>
    <rdfs:comment xml:lang="en">A date associated with the resource. Used in the Image, Video, 3D and (non-flat) Text standard models, which attach it without defining it. Whether it is distinct from hasCreationDate and hasTimePeriod is still to be confirmed with DaSCH.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#InformationResource"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#DateValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasTimePeriod">
    <rdfs:label xml:lang="en">Time period</rdfs:label>
    <rdfs:label xml:lang="de">Zeitraum</rdfs:label>
    <rdfs:comment xml:lang="en">Time period</rdfs:comment>
    <rdfs:comment xml:lang="de">Zeitraum</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#InformationResource"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#DateValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasLocationsCreatedList">
    <rdfs:label xml:lang="en">Location</rdfs:label>
    <rdfs:label xml:lang="de">Ort</rdfs:label>
    <rdfs:comment xml:lang="en">Location the media-file was created</rdfs:comment>
    <rdfs:comment xml:lang="de">Ort; an dem die Datei entstand</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#InformationResource"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#ListValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasLocationsMentionedList">
    <rdfs:label xml:lang="en">Locations mentioned</rdfs:label>
    <rdfs:label xml:lang="de">Erwähnte Orte</rdfs:label>
    <rdfs:comment xml:lang="en">Locations mentioned in recording</rdfs:comment>
    <rdfs:comment xml:lang="de">Orte; die in Aufnahme erwähnt werden</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#InformationResource"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#ListValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasLanguageList">
    <rdfs:label xml:lang="en">Language</rdfs:label>
    <rdfs:label xml:lang="de">Sprache</rdfs:label>
    <rdfs:comment xml:lang="en">Language used in the document</rdfs:comment>
    <rdfs:comment xml:lang="de">im Dokument verwendete Sprache </rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#InformationResource"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#ListValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasVersion">
    <rdfs:label xml:lang="en">Release version</rdfs:label>
    <rdfs:label xml:lang="de">Versionsnummer</rdfs:label>
    <rdfs:comment xml:lang="en">Release version of file</rdfs:comment>
    <rdfs:comment xml:lang="de">Versionsnummer der Datei</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#InformationResource"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#TextValue"/>
  </rdf:Property>


  <!-- ========== PROPERTIES of TimeBasedMedia and Audio ========== -->

  <rdf:Property rdf:about="#hasDuration">
    <rdfs:label xml:lang="en">Duration</rdfs:label>
    <rdfs:label xml:lang="de">Dauer</rdfs:label>
    <rdfs:comment xml:lang="en">Duration</rdfs:comment>
    <rdfs:comment xml:lang="de">Dauer</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#TimeBasedMedia"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#TextValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasSnippetPeriod">
    <rdfs:label xml:lang="en">Snippet period</rdfs:label>
    <rdfs:label xml:lang="de">Laufzeit des Ausschnitts</rdfs:label>
    <rdfs:comment xml:lang="en">Time period of snippet</rdfs:comment>
    <rdfs:comment xml:lang="de">Laufzeit des Ausschnitts</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#Audio"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#TextValue"/>
  </rdf:Property>


  <!-- ========== PROPERTIES of Agent, Person and Organisation ========== -->

  <rdf:Property rdf:about="#hasLanguageKnownList">
    <rdfs:label xml:lang="en">Languages known</rdfs:label>
    <rdfs:label xml:lang="de">Beherrschte Sprachen</rdfs:label>
    <rdfs:comment xml:lang="en">Languages known by Agent</rdfs:comment>
    <rdfs:comment xml:lang="de">Sprachen beherrscht von Agent</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#Agent"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#ListValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasLastName">
    <rdfs:label xml:lang="en">Last name</rdfs:label>
    <rdfs:label xml:lang="de">Nachname</rdfs:label>
    <rdfs:comment xml:lang="en">Last name of person</rdfs:comment>
    <rdfs:comment xml:lang="de">Nachname der Person</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#TextValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasFirstName">
    <rdfs:label xml:lang="en">First name</rdfs:label>
    <rdfs:label xml:lang="de">Vorname</rdfs:label>
    <rdfs:comment xml:lang="en">First name of person</rdfs:comment>
    <rdfs:comment xml:lang="de">Vorname der Person</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#TextValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasORCID">
    <rdfs:label xml:lang="en">ORCID id</rdfs:label>
    <rdfs:label xml:lang="de">ORCID Id</rdfs:label>
    <rdfs:comment xml:lang="en">ORCID identifier of resource</rdfs:comment>
    <rdfs:comment xml:lang="de">ORCID Identifikator der Ressource</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#UriValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasGND">
    <rdfs:label xml:lang="en">GND id</rdfs:label>
    <rdfs:label xml:lang="de">GND Id</rdfs:label>
    <rdfs:comment xml:lang="en">GND identifier of resource</rdfs:comment>
    <rdfs:comment xml:lang="de">GND-Identifikator der Ressource</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="http://www.knora.org/ontology/knora-base#UriValue"/>
  </rdf:Property>

  <rdf:Property rdf:about="#hasIdRef">
    <rdfs:label xml:lang="en">IdRef id</rdfs:label>
    <rdfs:label xml:lang="de">IdRef Id</rdfs:label>
    <rdfs:comment xml:lang="en">IdRef identifier of resource</rdfs:comment>
    <rdfs:comment xml:lang="de">IdRef-Identifikator der Ressource</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.knora.org/ontology/knora-base#hasValue"/>
    <rdfs:domain rdf:resource="#Person"/>
