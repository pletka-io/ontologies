<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:edm="http://www.europeana.eu/schemas/edm/" xmlns:ore="http://www.openarchives.org/ore/terms/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:dcmitype="http://purl.org/dc/dcmitype/" xmlns:dcat="http://www.w3.org/ns/dcat#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:foaf="http://xmlns.com/foaf/0.1/" xmlns:rdaGr2="http://rdvocab.info/ElementsGr2/" xmlns:wgs84_pos="http://www.w3.org/2003/01/geo/wgs84_pos#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:cc="http://creativecommons.org/ns#" xmlns:odrl="http://www.w3.org/ns/odrl/2/" xmlns:svcs="http://rdfs.org/sioc/services#" xmlns:doap="http://usefulinc.com/ns/doap#" xmlns:ebucore="http://www.ebu.ch/metadata/ontologies/ebucore/ebucore#" xmlns:schema="http://schema.org/" xmlns:vcard="http://www.w3.org/2006/vcard/ns#" xmlns:as="https://www.w3.org/ns/activitystreams#" xmlns:oa="http://www.w3.org/ns/oa#" xmlns:dqv="http://www.w3.org/ns/dqv#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xml:base="http://www.europeana.eu/schemas/edm/">
  <!--
						This document is an RDFS specification of an extended Europeana Data Model (EDM)
						class and property hierarchy. It includes the invented EDM superclasses introduced
						to serve as common domains/ranges for EDM properties (e.g. EDM:TOP_CLASS,
						EDM:CHO_OR_PROXY, EDM:TIME_OR_AGENT), and asserts subclass relationships placing
						both invented and existing EDM/external classes under these superclasses.

						For every property listed in the EDM domain/property/range table, this file
						asserts an rdfs:domain and rdfs:range, drawn from the union-class superclasses
						where appropriate, in order to make the model practically usable in applications
						requiring rdfs:domain / rdfs:range information.

						Style and formatting follow the AAAo (Art and Architectural Argumentation
						Ontology) RDF serialization conventions: rdfs:Class declarations with
						rdfs:label, rdfs:comment and rdfs:subClassOf; rdf:Property declarations with
						rdfs:label, rdfs:comment, rdfs:domain and rdfs:range.

						Namespace
						http://www.europeana.eu/schemas/edm/
  -->
  <!-- ============================================================ -->
  <!--  INVENTED EDM SUPERCLASSES                                    -->
  <!-- ============================================================ -->
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/TOP_CLASS">
    <rdfs:label xml:lang="en">Top Class</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the top class of the EDM class hierarchy. All classes in the model are direct or indirect subclasses of this class. It is introduced for purposes of providing a common root for the assertion of properties that apply across the model.</rdfs:comment>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/Information_Resource">
    <rdfs:label xml:lang="en">Information Resource</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises information objects, in the sense of propositional or symbolic content (e.g. texts, images, descriptions, datasets, web resources, fulltexts, provided cultural heritage objects). It is introduced as a superclass to group information-bearing entities within the EDM model.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/Non_information_resource">
    <rdfs:label xml:lang="en">Non Information Resource</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises entities that are not themselves information objects, i.e. agents, physical things, places, events and concepts. It is introduced as a superclass to group non-informational entities within the EDM model in contrast with EDM:Information_Resource.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/INFO_OR_CHO">
    <rdfs:label xml:lang="en">Information Resource or Provided CHO</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the union class of edm:ProvidedCHO and edm:WebResource. It is introduced to serve as the domain of properties applicable to either provided cultural heritage objects or web resources representing them.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/Information_Resource"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/CHO_OR_PROXY">
    <rdfs:label xml:lang="en">Provided CHO or Proxy</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the union class of edm:ProvidedCHO and ore:Proxy. It is introduced to serve as the domain or range of properties applicable to either a provided cultural heritage object or a proxy standing in for it.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/TIME_OR_AGENT">
    <rdfs:label xml:lang="en">Timespan or Agent</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the union class of edm:Timespan and edm:Agent. It is introduced to serve as the domain of properties applicable to either timespans or agents (e.g. edm:begin, edm:end).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/AGENT_OR_OBJ">
    <rdfs:label xml:lang="en">Agent or Timespan</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the union class of edm:Agent and edm:Timespan. It is introduced as a grouping class for entities that may be characterized by a temporal extent and that may participate in similar relations within the model.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/AGENT_OR_OBJ_OR_INFO">
    <rdfs:label xml:lang="en">Agent, Physical Thing or Information Resource</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the union class of edm:Agent, edm:Physical_Thing and EDM:Information_Resource. It is introduced as the domain of edm:wasPresentAt, covering those entities that may be said to have been present at an event.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/TOP_PLACE">
    <rdfs:label xml:lang="en">Top Place</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the union class of edm:Place and vcard:Location. It is introduced to serve as a common domain for place-related properties applicable to either kind of locative entity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/TOP_GROUP">
    <rdfs:label xml:lang="en">Top Group</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the union class of foaf:Organization and edm:Aggregator. It is introduced to serve as the domain of properties applicable to any kind of organizational or aggregating group.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/DIG_OBJ">
    <rdfs:label xml:lang="en">Digital Object</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises digital objects. It is introduced as a superclass for digital resource entities within the EDM model.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/APPELLATION">
    <rdfs:label xml:lang="en">Appellation</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the union class of vcard:Address and edm:PersistentIdentifier. It is introduced to group entities that serve as appellations or identifiers for other resources.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>

  <!-- ============================================================ -->
  <!--  EXISTING EDM / EXTERNAL CLASSES IN THE HIERARCHY              -->
  <!-- ============================================================ -->
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/ProvidedCHO">
    <rdfs:label xml:lang="en">Provided CHO</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises the cultural heritage objects that Europeana collects descriptions about.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/INFO_OR_CHO"/>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/CHO_OR_PROXY"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/WebResource">
    <rdfs:label xml:lang="en">Web Resource</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises web resources, i.e. resources accessible via the web, that represent or are related to cultural heritage objects.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/INFO_OR_CHO"/>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/DIG_OBJ"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/FullTextResource">
    <rdfs:label xml:lang="en">Full Text Resource</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises web resources that contain the full text of a cultural heritage object.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/WebResource"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/Physical_Thing">
    <rdfs:label xml:lang="en">Physical Thing</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises physical things, i.e. persistent material items including objects and places, within the EDM model.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/Non_information_resource"/>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/AGENT_OR_OBJ_OR_INFO"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/Agent">
    <rdfs:label xml:lang="en">Agent</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises people, either individually or in groups, who have the potential to perform intentional actions for which they can be held responsible.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/Non_information_resource"/>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TIME_OR_AGENT"/>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/AGENT_OR_OBJ"/>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/AGENT_OR_OBJ_OR_INFO"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/Place">
    <rdfs:label xml:lang="en">Place</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises extents in space, in particular on the surface of the earth, in the pure sense of physics.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/Non_information_resource"/>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_PLACE"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/Event">
    <rdfs:label xml:lang="en">Event</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises changes of states in cultural, social or physical systems, regardless of scale, bringing about new situations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/Non_information_resource"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
    <rdfs:label xml:lang="en">Concept</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises conceptual entities and ideas as defined by SKOS.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/Non_information_resource"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.openarchives.org/ore/terms/Proxy">
    <rdfs:label xml:lang="en">Proxy</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises proxies, i.e. resources standing in for an aggregated resource in the context of a specific aggregation, as defined by OAI-ORE.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/CHO_OR_PROXY"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://purl.org/dc/dcmitype/Collection">
    <rdfs:label xml:lang="en">Collection</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises an aggregation of resources, as defined by DCMI.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/dcat#Dataset">
    <rdfs:label xml:lang="en">Dataset</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises a collection of data published or curated by a single agent, as defined by DCAT.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/dc/dcmitype/Collection"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.openarchives.org/ore/terms/Aggregation">
    <rdfs:label xml:lang="en">Aggregation</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises aggregations of resources, as defined by OAI-ORE.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/dc/dcmitype/Collection"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/EuropeanaObject">
    <rdfs:label xml:lang="en">Europeana Object</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises objects native to the Europeana data model and infrastructure.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/EuropeanaAggregation">
    <rdfs:label xml:lang="en">Europeana Aggregation</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises aggregations created and managed by Europeana itself.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.openarchives.org/ore/terms/Aggregation"/>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/EuropeanaObject"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/Timespan">
    <rdfs:label xml:lang="en">Timespan</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises abstract temporal extents having a beginning, an end and a duration.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TIME_OR_AGENT"/>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/AGENT_OR_OBJ"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/2006/vcard/ns#Location">
    <rdfs:label xml:lang="en">Location</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises locations as defined by the vCard ontology.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_PLACE"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://xmlns.com/foaf/0.1/Organization">
    <rdfs:label xml:lang="en">Organization</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises organizations, as defined by FOAF.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_GROUP"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/Aggregator">
    <rdfs:label xml:lang="en">Aggregator</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises aggregating organizations within the Europeana network.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_GROUP"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/2006/vcard/ns#Address">
    <rdfs:label xml:lang="en">Address</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises postal addresses, as defined by the vCard ontology.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/APPELLATION"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/PersistentIdentifier">
    <rdfs:label xml:lang="en">Persistent Identifier</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises persistent identifiers assigned to digital or non-digital resources.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/APPELLATION"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://rdfs.org/sioc/services#Service">
    <rdfs:label xml:lang="en">Service</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises services that can be invoked over the web.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://creativecommons.org/ns#Licence">
    <rdfs:label xml:lang="en">Licence</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises licences governing the use of resources, as defined by Creative Commons.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.w3.org/ns/dqv#QualityAnnotation">
    <rdfs:label xml:lang="en">Quality Annotation</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises annotations expressing data quality assessments, as defined by DQV.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="https://www.w3.org/ns/activitystreams#Delete">
    <rdfs:label xml:lang="en">Delete</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises activities that delete a resource, as defined by ActivityStreams.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>
  <rdfs:Class rdf:about="http://www.europeana.eu/schemas/edm/PersistentIdentifierScheme">
    <rdfs:label xml:lang="en">Persistent Identifier Scheme</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class comprises schemes for assigning persistent identifiers.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdfs:Class>

  <!-- ============================================================ -->
  <!--  PROPERTIES                                                    -->
  <!-- ============================================================ -->
  <rdf:Property rdf:about="http://purl.org/dc/elements/1.1/title">
    <rdfs:label xml:lang="en">title</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This property relates an instance of EDM:TOP_CLASS to a literal value. It is reused from its source vocabulary in the context of the EDM model.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://purl.org/dc/terms/alternative">
    <rdfs:label xml:lang="en">alternative</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This property relates an instance of EDM:TOP_CLASS to a literal value. It is reused from its source vocabulary in the context of the EDM model.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://purl.org/dc/elements/1.1/identifier">
    <rdfs:label xml:lang="en">identifier</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This property relates an instance of EDM:TOP_CLASS to a literal value. It is reused from its source vocabulary in the context of the EDM model.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://www.w3.org/2002/07/owl#sameAs">
    <rdfs:label xml:lang="en">same as</rdfs:label>
    <rdfs:comment xml:lang="en" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This property relates an instance of EDM:TOP_CLASS to an instance of EDM:TOP_CLASS. It is reused from its source vocabulary in the context of the EDM model.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
    <rdfs:range rdf:resource="http://www.europeana.eu/schemas/edm/TOP_CLASS"/>
  </rdf:Property>
  <rdf:Property rdf:about="http://purl.org/dc/elements/1.1/type">
