  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OMO_0002000">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <x59a354be:IAO_0000112>'part disjoint with' 'defined by construct' """
    PREFIX owl: &lt;http://www.w3.org/2002/07/owl#&gt;
    PREFIX : &lt;http://example.org/
    CONSTRUCT {
      [
        a owl:Restriction ;
        owl:onProperty :part_of ;
        owl:someValuesFrom ?a ;
        owl:disjointWith [
          a owl:Restriction ;
          owl:onProperty :part_of ;
          owl:someValuesFrom ?b
        ]
      ]
    }
    WHERE {
      ?a :part_disjoint_with ?b .
    }</x59a354be:IAO_0000112>
    <x59a354be:IAO_0000115>Links an annotation property to a SPARQL CONSTRUCT query which is meant to provide semantics for a shortcut relation.</x59a354be:IAO_0000115>
    <xaf09014d:label>defined by construct</xaf09014d:label>
  </rdf:Description>
