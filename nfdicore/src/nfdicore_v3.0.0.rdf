  </rdf:Description>
  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001016">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <xaf09014d:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000578"/>
    <x59a354be:IAO_0000118 xml:lang="fr">Répertoire International des Sources Musicales</x59a354be:IAO_0000118>
    <x59a354be:IAO_0000119>https://rism.info/</x59a354be:IAO_0000119>
    <xaf09014d:label xml:lang="en">RISM identifier</xaf09014d:label>
    <x063752c9:definition xml:lang="en">RISM (Répertoire International des Sources Musicales) is an international catalog of historical music sources, including manuscripts, printed music, and treatises. It provides unique identifiers and bibliographic data to support music research and documentation.</x063752c9:definition>
    <x063752c9:example>https://rism.online/sources/201001959/</x063752c9:example>
    <x6fb588ae:NFDI_0010013>https://github.com/ISE-FIZKarlsruhe/nfdicore/issues/61</x6fb588ae:NFDI_0010013>
    <x6fb588ae:NFDI_0010015 xml:lang="en">RISM</x6fb588ae:NFDI_0010015>
  </rdf:Description>
