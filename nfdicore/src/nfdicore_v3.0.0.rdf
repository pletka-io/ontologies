    <xeb179d48:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
    <xeb179d48:someValuesFrom rdf:nodeID="N84b187deec9a4903bbaecf8c03719e0d"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N184f601549b54e28b1d6b84cc30081bb">
