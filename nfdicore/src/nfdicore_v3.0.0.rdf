  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000103">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <x59a354be:IAO_0000115 xml:lang="en">The term was initially used in an attempt to structure part of the ontology, but in retrospect failed to do a good job.</x59a354be:IAO_0000115>
    <x59a354be:IAO_0000116 xml:lang="en">Terms created as placeholders with the expectation of being permanent should instead be deprecated using the "placeholder removed" (obo:IAO_0000226) justification.</x59a354be:IAO_0000116>
    <xaf09014d:label xml:lang="en">failed exploratory term</xaf09014d:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N6edfa046cfb64be29fc28c99b4059ecd">
    <xc846f0e1:first rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
    <xc846f0e1:rest rdf:nodeID="Nc669979cc01e48088219f13a458e5e73"/>
