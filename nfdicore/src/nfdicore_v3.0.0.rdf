  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000232">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <xaf09014d:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
    <xaf09014d:label xml:lang="en">service product</xaf09014d:label>
    <x063752c9:definition xml:lang="en">An immaterial entity that provides value through a service offering, delivering intangible benefits or functionality designed to fulfill specific needs or requirements, often in a structured process.</x063752c9:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0010020">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <xaf09014d:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000018"/>
    <xaf09014d:label xml:lang="en">conference</xaf09014d:label>
    <x063752c9:definition xml:lang="en">An event where experts and scholars gather to present research, exchange ideas, and discuss advancements in a particular field.</x063752c9:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbb4ba7a3b83f4971bcf559cc90d3bbc6">
