  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000101">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <xaf09014d:subClassOf rdf:nodeID="Naf6d4afcb15e4de0bc8960396a2461c4"/>
    <xaf09014d:label xml:lang="en">service process</xaf09014d:label>
    <x063752c9:definition xml:lang="en">A process that organizes activities and resources to deliver a specific service, ensuring its efficiency, reliability, and alignment with intended goals.</x063752c9:definition>
    <x6fb588ae:NFDI_0010013>Issue: https://github.com/ISE-FIZKarlsruhe/nfdicore/issues/75</x6fb588ae:NFDI_0010013>
  </rdf:Description>
