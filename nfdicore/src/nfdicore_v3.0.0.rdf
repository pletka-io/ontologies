  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000410">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <x59a354be:IAO_0000116 xml:lang="en">Hard to give a definition for. Intuitively a "natural kind" rather than a collection of any old things, which a class is able to be, formally. At the meta level, universals are defined as positives, are disjoint with their siblings, have single asserted parents.</x59a354be:IAO_0000116>
    <x59a354be:IAO_0000119 xml:lang="en">A Formal Theory of Substances, Qualities, and Universals, http://ontology.buffalo.edu/bfo/SQU.pdf</x59a354be:IAO_0000119>
    <xaf09014d:label xml:lang="en">universal</xaf09014d:label>
  </rdf:Description>
