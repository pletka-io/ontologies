  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001061">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <xaf09014d:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000229"/>
    <xaf09014d:label xml:lang="en">organizer role</xaf09014d:label>
    <x063752c9:definition xml:lang="en">A role inherent in an agent that is realized when being responsible for planning, managing, and executing an event, project, or structured activity.</x063752c9:definition>
    <x063752c9:example>event management firms organizing scientific symposiums or non-profit organizations coordinating community outreach programs</x063752c9:example>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N627fe1246c07425b8ab1ecf35027bb79">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
