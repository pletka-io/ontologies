  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <xaf09014d:label xml:lang="en">preferred label</xaf09014d:label>
    <x063752c9:definition xml:lang="en">The preferred lexical label for a resource, in a given language.</x063752c9:definition>
