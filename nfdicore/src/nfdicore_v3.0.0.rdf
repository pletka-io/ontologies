    <xc846f0e1:type rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000100"/>
    <xaf09014d:label xml:lang="en">medicine</xaf09014d:label>
    <xaf09014d:seeAlso>https://www.dfg.de/en/research-funding/proposal-funding-process/interdisciplinarity/subject-area-structure</xaf09014d:seeAlso>
    <x063752c9:definition xml:lang="en">An academic discipline that focuses on the science and practice of diagnosing, treating, and preventing illnesses and injuries. Medicine involves the study of human health, medical technologies, pharmaceuticals, and patient care to improve well-being and extend life.</x063752c9:definition>
  </rdf:Description>
