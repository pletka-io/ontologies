    <xeb179d48:someValuesFrom rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001120"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://edamontology.org/format_3261">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <xaf09014d:subClassOf rdf:resource="http://edamontology.org/format_2376"/>
    <xaf09014d:label>RDF/XML</xaf09014d:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002350">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <xaf09014d:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
    <xeb179d48:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
    <x59a354be:IAO_0000112>An organism that is a member of a population of organisms</x59a354be:IAO_0000112>
    <x59a354be:IAO_0000115>is member of is a mereological relation between a item and a collection.</x59a354be:IAO_0000115>
    <x59a354be:IAO_0000119>SIO</x59a354be:IAO_0000119>
    <xaf09014d:label xml:lang="en">member of</xaf09014d:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0010030">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <xaf09014d:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0010028"/>
    <xaf09014d:label xml:lang="en">data processing process</xaf09014d:label>
    <xaf09014d:seeAlso rdf:resource="http://purl.obolibrary.org/obo/T4FS_0000044"/>
    <x063752c9:definition>A data handling process where raw data is cleaned, transformed, and analyzed to extract meaningful insights, patterns, or trends.</x063752c9:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc8dd1e63285f45f8a656522a36f22463">
    <xc846f0e1:first rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000229"/>
    <xc846f0e1:rest rdf:nodeID="Nef334d02608846b9b500c826cec143c5"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001041">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <xaf09014d:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
    <xaf09014d:isDefinedBy>http://purl.obolibrary.org/obo/IAO_0000646</xaf09014d:isDefinedBy>
    <xaf09014d:label xml:lang="en">postal code</xaf09014d:label>
    <x063752c9:definition>An identifier that denotes some postal delivery route, some aggregate of postal delivery routes or a geographical region and was created for the purpose of sorting and delivering mail.</x063752c9:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf5f5f545876f43d0bafb6e14cc1b601e">
    <xc846f0e1:first rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000229"/>
