  <rdf:Description rdf:nodeID="N6ede97b55d0d47d9afb736b78ed69bd4">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <xeb179d48:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
