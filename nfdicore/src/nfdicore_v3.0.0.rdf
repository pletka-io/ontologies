  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001058">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <xaf09014d:subClassOf rdf:nodeID="N42286504b50c443d88e178368726b6cd"/>
    <xaf09014d:label xml:lang="en">co spokesperson role</xaf09014d:label>
    <x063752c9:definition xml:lang="en">A role inherent in an agent that is realized when shareing the responsibilities of representing an organization, group, or initiative, typically communicating its views, policies, or findings to the public.</x063752c9:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N455369b86c9a4436833abc17a8a69d1a">
