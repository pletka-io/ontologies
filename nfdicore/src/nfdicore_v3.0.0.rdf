  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0010013">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <xaf09014d:label xml:lang="en">term tracker annotation</xaf09014d:label>
    <x063752c9:definition>A term tracker annotation is an editor note used to track the history of an entity. For each change, it records the related GitHub issue and pull request.</x063752c9:definition>
    <x063752c9:editorialNote>adapted from http://openenergy-platform.org/ontology/oeo/OEO_00020426</x063752c9:editorialNote>
  </rdf:Description>
