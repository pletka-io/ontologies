  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002233">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <xaf09014d:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
    <xeb179d48:inverseOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002352"/>
    <xaf09014d:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
    <x59a354be:IAO_0000115>p has input c iff: p is a process, c is a material entity, c is a participant in p, c is present at the start of p, and the state of c is modified during p.</x59a354be:IAO_0000115>
    <xaf09014d:label xml:lang="en">has input</xaf09014d:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000022">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <x59a354be:IAO_0000112>A journal article, patent application, laboratory notebook, or a book</x59a354be:IAO_0000112>
    <x59a354be:IAO_0000119>http://purl.obolibrary.org/obo/IAO_0000310</x59a354be:IAO_0000119>
    <x59a354be:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
    <xaf09014d:label xml:lang="en">obsolete document</xaf09014d:label>
    <xeb179d48:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</xeb179d48:deprecated>
    <x063752c9:definition xml:lang="en">A collection of information content entities intended to be understood together as a whole</x063752c9:definition>
  </rdf:Description>
