    <x59a354be:IAO_0000116 xml:lang="en">This is to be used when the original term has been replaced by a term imported from an other ontology. The deprecated term should reference the imported term with obo:IAO_0100001.</x59a354be:IAO_0000116>
    <xaf09014d:label xml:lang="en">term imported</xaf09014d:label>
  </rdf:Description>
