  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0010019">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <xaf09014d:subClassOf rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000018"/>
    <xaf09014d:label xml:lang="en">workshop</xaf09014d:label>
    <x063752c9:definition xml:lang="en">An event focused on interactive learning, where participants engage in hands-on activities or group work to develop specific skills or knowledge.</x063752c9:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001066">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <xc846f0e1:type rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000100"/>
    <x063752c9:broader rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0010017"/>
    <x59a354be:IAO_0000119>Provost, F., &amp; Fawcett, T. (2013). Data Science for Business. O'Reilly Media.</x59a354be:IAO_0000119>
    <xaf09014d:label xml:lang="en">data science</xaf09014d:label>
    <x063752c9:definition>Data Science is a sub-discipline of Computer Science that integrates statistical methods, machine learning, and data processing techniques to extract insights and knowledge from structured and unstructured data.</x063752c9:definition>
    <x063752c9:example>Predictive analytics, big data visualization, and recommendation systems are part of Data Science.</x063752c9:example>
  </rdf:Description>
