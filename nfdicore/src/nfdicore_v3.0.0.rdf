  <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000121">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <xaf09014d:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
    <xeb179d48:inverseOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000139"/>
    <xaf09014d:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
    <xaf09014d:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
    <xc05abd6b:identifier>211-BFO</xc05abd6b:identifier>
    <xaf09014d:label xml:lang="en">has temporal part</xaf09014d:label>
    <x063752c9:definition xml:lang="en">b has temporal part c =Def c temporal part of b</x063752c9:definition>
    <x063752c9:example xml:lang="en">Your life has temporal part the first year of your life</x063752c9:example>
  </rdf:Description>
