  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000014">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <x59a354be:IAO_0000119>http://purl.obolibrary.org/obo/IAO_0000444</x59a354be:IAO_0000119>
    <x59a354be:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000444"/>
    <xaf09014d:label xml:lang="en">obsolete publishing process</xaf09014d:label>
    <xeb179d48:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</xeb179d48:deprecated>
    <x063752c9:definition xml:lang="en">A process of making information, such as literature, music, and software etc., available to the public for sale or for free.</x063752c9:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ned12fc86360f4e6baa04a9a2ab8733f3">
