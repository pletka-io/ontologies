  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0010031">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <xaf09014d:subClassOf rdf:nodeID="N8a5db769667546c5ad504f6a02668678"/>
    <xaf09014d:label xml:lang="en">dataset creation process</xaf09014d:label>
    <x063752c9:definition>A data handling process involving the organization and structuring of data into datasets for easier access, analysis, and sharing.</x063752c9:definition>
  </rdf:Description>
