  <rdf:Description rdf:about="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000159">
    <xc846f0e1:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <xc846f0e1:type rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000100"/>
    <xaf09014d:label xml:lang="en">process engineering</xaf09014d:label>
    <xaf09014d:seeAlso>https://www.dfg.de/en/research-funding/proposal-funding-process/interdisciplinarity/subject-area-structure</xaf09014d:seeAlso>
    <x063752c9:definition xml:lang="en">An academic discipline that focuses on the design, optimization, and operation of industrial processes to transform raw materials into valuable products. Process engineering applies principles of chemistry, physics, and engineering to improve efficiency, sustainability, and safety in industries such as manufacturing, energy, and pharmaceuticals.</x063752c9:definition>
  </rdf:Description>
