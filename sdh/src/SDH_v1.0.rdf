    <rdfs:domain rdf:resource="https://sdhss.org/ontology/core/1.0/C75_Person_Classification"/>
  </rdf:Property>
  <rdf:Property rdf:about="https://sdhss.org/ontology/core/1.0/P9_has_construction_type">
    <rdfs:range rdf:resource="https://sdhss.org/ontology/core/1.0/C18_Construction_Type"/>
    <rdfs:comment xml:lang="en">Associates an instance of sdh:C17 Construction with the instance of sdh:C18 Construction Type which defines its identity</rdfs:comment>
    <rdfs:label xml:lang="en">has construction type</rdfs:label>
    <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">P96</skos:notation>
    <rdfs:domain rdf:resource="https://sdhss.org/ontology/core/1.0/C17_Construction"/>
    <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
