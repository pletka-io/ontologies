    <rdfs:subPropertyOf rdf:resource="https://sdhss.org/ontology/core/1.0/P21_is_connotated_by"/>
  </rdf:Property>
  <rdf:Property rdf:about="https://sdhss.org/ontology/core/1.0/P95_classifies">
    <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
    <rdfs:comment xml:lang="en">This property associates the Person Classification with the Person concerned.</rdfs:comment>
    <rdfs:label xml:lang="en">classifies</rdfs:label>
