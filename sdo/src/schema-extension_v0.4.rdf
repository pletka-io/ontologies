    <rdfs:comment xml:lang="en">Scope note:
Date of first publication or broadcast. (schema.org)

Implementation note:
Domain obo:BFO_0000001 (entity), the top-level class: used on data portals, publications, news articles and NFDI resources. All values are xsd:date.
</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001" />
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date" />
    <rdfs:isDefinedBy rdf:resource="https://schema.org/" />
  </rdf:Property>
  <rdf:Property rdf:about="https://schema.org/dateCreated">
    <rdfs:label xml:lang="en">date created</rdfs:label>
    <rdfs:comment xml:lang="en">Scope note:
The date on which the CreativeWork was created or the item was added to a DataFeed. (schema.org)

Implementation note:
Domain obo:BFO_0000001 (entity), the top-level class: used on data feeds and data feed items. Range rdfs:Literal: values carry xsd:date and the unexpanded datatype "xsd:date".
</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001" />
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal" />
    <rdfs:isDefinedBy rdf:resource="https://schema.org/" />
  </rdf:Property>
  <rdf:Property rdf:about="https://schema.org/dateModified">
    <rdfs:label xml:lang="en">date modified</rdfs:label>
    <rdfs:comment xml:lang="en">Scope note:
The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed. (schema.org)

Implementation note:
Domain obo:BFO_0000001 (entity), the top-level class: used on data feeds and data feed items. Range rdfs:Literal: values are xsd:date, xsd:string, xsd:dateTime and the unexpanded "xsd:date".
</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001" />
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal" />
    <rdfs:isDefinedBy rdf:resource="https://schema.org/" />
